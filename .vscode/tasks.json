{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: signal_filter",
      "type": "shell",
      "command": "C:/mingw64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Iinclude",
        "src/main.cpp",
        "src/MovingAverageFilter.cpp",
        "-o",
        "${workspaceFolder}/signal_filter.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$gcc"
    }
  ]
}

